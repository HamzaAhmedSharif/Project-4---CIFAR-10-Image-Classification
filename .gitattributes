# Auto detect text files and perform LF normalization
* text=auto

# Images
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary

# Model files
*.pth filter=lfs diff=lfs merge=lfs -text
*.pt filter=lfs diff=lfs merge=lfs -text
*.onnx filter=lfs diff=lfs merge=lfs -text
*.pb filter=lfs diff=lfs merge=lfs -text

# Archives
*.zip binary
*.tar.gz binary
*.7z binary

# Jupyter notebooks
*.ipynb text eol=lf

# Python
*.py text eol=lf
*.pyx text eol=lf
*.pyd binary
*.pyo binary
*.pyc binary

# Documents
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Shell scripts
*.sh text eol=lf
*.bash text eol=lf

# Windows scripts
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf